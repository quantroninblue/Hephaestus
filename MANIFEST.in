include README.md
include LICENSE
include NOTICE
include PRIVACY.md
include SAFETY.md
include SECURITY.md
include RESPONSIBLE_USE.md
include THIRD_PARTY_NOTICES.md
graft src/hephaestus
prune tests
prune generated
prune dist
prune build
prune .venv
prune .pytest_cache
prune .ruff_cache
prune .hypothesis
global-exclude __pycache__/*
global-exclude *.py[cod]
global-exclude *.so
global-exclude .env
global-exclude .env.*
global-exclude project_state.txt
